// ============================================
// PropManagerPro — Core Database Schema 
// Revised: Pre-Migration Architecture Review
// FIX: Removed invalid Unit.tenants relation
// FIX: Added User model for authentication
// UPDATED: Property.userId and Property.user now required
// REFACTOR: Standard Prisma client generation
// REFACTOR: Direct tenant ownership (v0.6.1)
// ADDED: Soft delete support for Property (deletedAt)
// ADDED: Soft delete support for Unit (deletedAt)
// ADDED: Soft delete support for Tenant (deletedAt)
// ADDED: AuditLog model for activity tracking (v0.7.0)
// UPDATED: Optimized indexes for AuditLog (scalability)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS — Financial Safety & Data Integrity
// ============================================

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentMethod {
  cash
  bank_transfer
  card
  check
}

enum UserRole {
  LANDLORD
  MANAGER
  ADMIN
}

// ============================================
// 1. USER
// ============================================
// System users who manage properties

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  role      UserRole   @default(LANDLORD)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relationships
  properties Property[]
  tenants   Tenant[]
  auditLogs AuditLog[]

  @@map("users")
}

// ============================================
// 2. PROPERTY
// ============================================
// A building or complex managed by PropManager Pro.
// Examples: "Sunset Apartments", "Oakwood Villas"
//
// Soft delete: deletedAt is null for active properties.
// Set to timestamp when deleted. 30-day recovery window.

model Property {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zip         String
  unitCount   Int
  deletedAt   DateTime?  // 👈 Soft delete field (null = active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // User relation (now required)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relationships
  units       Unit[]
  leases      Lease[]

  @@map("properties")
}

// ============================================
// 3. UNIT
// ============================================
// A single rentable space inside a property.
// Examples: "Apartment 3B", "Unit 101"
// 
// NOTE: isOccupied REMOVED — occupancy is
// computed from active leases (single source of truth)
//
// Soft delete: deletedAt is null for active units.
// Set to timestamp when deleted. Preserves historical lease data.

model Unit {
  id          String   @id @default(cuid())
  unitNumber  String
  bedrooms    Int
  bathrooms   Float
  squareFeet  Int?
  rentAmount  Decimal
  deletedAt   DateTime?  // 👈 Soft delete field (null = active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leases      Lease[]

  @@unique([propertyId, unitNumber])
  @@map("units")
}

// ============================================
// 4. TENANT
// ============================================
// A person who rents a unit.
// Ownership: Direct userId (v0.6.1)
// Email uniqueness: Per landlord (composite with userId)
//
// Soft delete: deletedAt is null for active tenants.
// Set to timestamp when deleted. Preserves historical lease data.

model Tenant {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String
  phone             String?
  emergencyContact  String?
  userId            String
  deletedAt         DateTime?  // ← Soft delete field (null = active)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leases            Lease[]
  payments          Payment[]

  @@unique([userId, email])
  @@index([deletedAt])
  @@map("tenants")
}

// ============================================
// 5. LEASE
// ============================================
// A rental contract linking a tenant to a unit
// within a property for a specific time period.

model Lease {
  id              String    @id @default(cuid())
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Decimal
  securityDeposit Decimal
  isActive        Boolean   @default(true)
  signedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Foreign keys
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relationships
  payments        Payment[]

  @@map("leases")
}

// ============================================
// 6. PAYMENT
// ============================================
// Tracks every rent payment.
// NEVER delete payments — void them instead.

model Payment {
  id          String        @id @default(cuid())
  amount      Decimal
  paymentDate DateTime      @default(now())
  method      PaymentMethod @default(bank_transfer)
  status      PaymentStatus @default(completed)
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Foreign keys
  leaseId     String
  lease       Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ============================================
// 7. AUDIT LOG (Optimized for Scale)
// ============================================
// Tracks all user actions for security and compliance.
// Records who did what, when, and on which entity.
//
// INDEX STRATEGY for millions of logs:
// - userId + createdAt: Fast user activity queries
// - entityType + entityId: Fast entity history
// - action: Fast action filtering
// - createdAt: Fast time-based queries

model AuditLog {
  id          String   @id @default(cuid())

  userId      String
  action      String   // e.g., "TENANT_CREATED", "PROPERTY_UPDATED", "UNIT_ARCHIVED"
  entity      String   // e.g., "Property", "Unit", "Tenant", "Lease", "Payment", "Auth"
  entityId    String

  metadata    Json?    // Additional context (changes, IP, user agent, requestId, sessionId, role)

  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ OPTIMIZED INDEXES FOR SAAS SCALE
  @@index([userId, createdAt(sort: Desc)])  // Fast user activity feed
  @@index([entity, entityId])                // Fast entity history
  @@index([action])                          // Fast action filtering
  @@index([createdAt])                       // Fast time-based cleanup

  @@map("audit_logs")
}