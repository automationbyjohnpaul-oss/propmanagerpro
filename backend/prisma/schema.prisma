// ============================================
// PropManagerPro — Core Database Schema 
// Revised: Pre-Migration Architecture Review
// FIX: Removed invalid Unit.tenants relation
// FIX: Added User model for authentication
// UPDATED: Property.userId and Property.user now required
// REFACTOR: Standard Prisma client generation
// REFACTOR: Direct tenant ownership (v0.6.1)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS — Financial Safety & Data Integrity
// ============================================

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentMethod {
  cash
  bank_transfer
  card
  check
}

enum UserRole {
  LANDLORD
  MANAGER
  ADMIN
}

// ============================================
// 1. USER
// ============================================
// System users who manage properties

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  role      UserRole   @default(LANDLORD)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relationships
  properties Property[]
  tenants   Tenant[]

  @@map("users")
}

// ============================================
// 2. PROPERTY
// ============================================
// A building or complex managed by PropManager Pro.
// Examples: "Sunset Apartments", "Oakwood Villas"

model Property {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zip         String
  unitCount   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // User relation (now required)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relationships
  units       Unit[]
  leases      Lease[]

  @@map("properties")
}

// ============================================
// 3. UNIT
// ============================================
// A single rentable space inside a property.
// Examples: "Apartment 3B", "Unit 101"
// 
// NOTE: isOccupied REMOVED — occupancy is
// computed from active leases (single source of truth)

model Unit {
  id          String   @id @default(cuid())
  unitNumber  String
  bedrooms    Int
  bathrooms   Float
  squareFeet  Int?
  rentAmount  Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leases      Lease[]

  @@unique([propertyId, unitNumber])
  @@map("units")
}

// ============================================
// 4. TENANT
// ============================================
// A person who rents a unit.
// Ownership: Direct userId (v0.6.1)

model Tenant {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String   @unique
  phone             String?
  emergencyContact  String?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  leases            Lease[]
  payments          Payment[]

  @@map("tenants")
}

// ============================================
// 5. LEASE
// ============================================
// A rental contract linking a tenant to a unit
// within a property for a specific time period.

model Lease {
  id              String    @id @default(cuid())
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Decimal
  securityDeposit Decimal
  isActive        Boolean   @default(true)
  signedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Foreign keys
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relationships
  payments        Payment[]

  @@map("leases")
}

// ============================================
// 6. PAYMENT
// ============================================
// Tracks every rent payment.
// NEVER delete payments — void them instead.

model Payment {
  id          String        @id @default(cuid())
  amount      Decimal
  paymentDate DateTime      @default(now())
  method      PaymentMethod @default(bank_transfer)
  status      PaymentStatus @default(completed)
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Foreign keys
  leaseId     String
  lease       Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payments")
}